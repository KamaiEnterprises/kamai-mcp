{
  "name": "kamai-mcp",
  "version": "0.1.0",
  "description": "Kamai's MCP server: tools and MCP Apps widgets for construction-blueprint projects, blueprints and takeoffs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamaiEnterprises/kamai-mcp.git"
  },
  "homepage": "https://www.kamai.io",
  "bugs": {
    "url": "https://github.com/KamaiEnterprises/kamai-mcp/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.3",
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "bun run typecheck && bun run build:widgets",
    "build:widgets": "node scripts/build-widgets.mjs",
    "dev": "bun run build:widgets && bun --watch src/index.ts",
    "local": "bun src/local.ts",
    "start": "bun src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.42",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "tailwindcss": "^4.2.4",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
