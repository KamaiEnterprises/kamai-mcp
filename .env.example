PORT=8006

# Placeholders. Replace both before starting: MCP_PUBLIC_URL is the URL hosts will call
# (a tunnel, not localhost; the accepted token audience is derived from it) and
# MCP_AUTH_ISSUER must equal the access token's iss exactly.
MCP_PUBLIC_URL=https://mcp.example.com
MCP_AUTH_ISSUER=https://auth.example.com

# Optional; defaults to {MCP_AUTH_ISSUER}/jwks.json
MCP_AUTH_JWKS_URI=
MCP_API_BASE_URL=http://127.0.0.1:8005
