PORT=8006

# Placeholders. Replace both before starting the HTTP server: MCP_PUBLIC_URL is the URL
# hosts will call (a tunnel, not localhost) and MCP_AUTH_ISSUER must equal the access
# token's iss exactly.
MCP_PUBLIC_URL=https://mcp.example.com
MCP_AUTH_ISSUER=https://auth.example.com

# Optional; defaults to {MCP_AUTH_ISSUER}/jwks.json
MCP_AUTH_JWKS_URI=

# Kamai's MCP API. Access tokens carry this address as their audience, and this server
# accepts exactly that audience, so the same token is valid here and at the API directly.
MCP_API_BASE_URL=https://mcp-api.kamai.io

# Optional: accepted audiences, comma-separated. Defaults to MCP_API_BASE_URL.
MCP_ACCEPTED_AUDIENCES=

# Local mode (`bun run local`, stdio): a personal Kamai API key instead of OAuth.
KAMAI_API_KEY=
