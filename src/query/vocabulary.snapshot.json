  "group_by": [
    "blueprint_id",
    "folder",
    "folder_path",
    "class",
    "sub_class",
    "tag",
    "handing",
    "kind",
    "name",
    "color",
    "blueprint_discipline"
  ],
  "order_by": [
    "area_m2",
    "perimeter_m",
    "length_m",
    "width_m",
    "name",
    "tag",
    "handing",
    "class",
    "sub_class",
    "blueprint_discipline",
    "updated_at"
  ],
  "fields": [
    {
      "name": "kind",
      "kind": "enum",
      "doc": "area | line | object | text | folder"
    },
    {
      "name": "class",
      "kind": "enum",
      "doc": "room | wall | wall_centerline | wall_surface | wall_surface_with_opening | opening | footprint | other"
    },
    {
      "name": "sub_class",
      "kind": "enum",
      "doc": "'wet room', 'wet wall', 'single swing door', 'window', 'toilet' … null = unclassified"
    },
    {
      "name": "blueprint_discipline",
      "kind": "enum",
      "doc": "NCS5 letter: A Architectural, S Structural, M Mechanical, E Electrical, …; null on sheets ingested before this field existed"
    },
    {
      "name": "name",
      "kind": "text",
      "doc": "the element's label"
    },
    {
      "name": "tag",
      "kind": "text",
      "doc": "drawing mark, e.g. 'D1'"
    },
    {
      "name": "handing",
      "kind": "enum",
      "doc": "LH | RH | LHR | RHR, single swing doors only. LH/RH: the hinge side seen from the side the door swings away from, read off the drawing. LHR/RHR: the reverse (pull-side) handings, present only when a client stored them. null where undecided or not a swing door"
    },
    {
      "name": "folder",
      "kind": "text",
      "doc": "the immediate parent folder's name; top-level features carry 'Root'; `folder_path` is null at the root"
    },
    {
      "name": "ref",
      "kind": "text",
      "doc": "a `ref` from an earlier result; eq / ne / in / not_in only. A ref on a sheet outside `sheets` is an error; a well-formed ref that names no element on its sheet matches nothing"
    },
    {
      "name": "color",
      "kind": "number",
      "doc": "packed RGBA integer"
    },
    {
      "name": "is_user_drawn",
      "kind": "bool",
      "doc": "drawn by hand, not detected"
    },
    {
      "name": "confidence",
      "kind": "number",
      "doc": "text only: 1.0 digital, lower OCR"
    },
    {
      "name": "updated_at",
      "kind": "time",
      "doc": "last write"
    },
    {
      "name": "area_m2",
      "kind": "measure",
      "doc": "polygons only; null for lines"
    },
    {
      "name": "length_m",
      "kind": "measure",
      "doc": "lines only; null for polygons"
    },
    {
      "name": "perimeter_m",
      "kind": "measure",
      "doc": "polygons only"
    },
    {
      "name": "width_m",
      "kind": "measure",
      "doc": "clear width; openings only"
    }
  ],
  "operators": [
    "eq",
    "ne",
    "in",
    "not_in",
    "is_null",
    "not_null",
    "contains",
    "starts_with",
    "gt",
    "gte",
    "lt",
    "lte",
    "between"
  ],
  "limits": {
    "where_max_chars": 4096,
    "where_max_nodes": 64,
    "in_list_max_values": 500,
    "near_max_metres": 50.0,
    "blueprints_per_call": 25,
    "rows_per_page": 200,
    "groups_per_result": 200,
    "rooms_per_wall_surface_call": 200,
    "selections_per_table": 5,
    "queries_in_flight_per_user": 3
  }
}
